#!/usr/bin/env bash

if [[ -z "$1" ]]; then
  echo "no domain in first position. failing"
  exit 1
fi

if [[ -z "$2" ]]; then
  echo "no destination directory in second position. failing"
  exit 1
fi

mkdir -p $2
# Copy certificates from user's sslcerts directory (mkcert generates them there)
if [[ -f "$HOME/sslcerts/fullchain.pem" ]] && [[ -f "$HOME/sslcerts/privkey.pem" ]]; then
  cp -f "$HOME/sslcerts/fullchain.pem" "$2/"
  cp -f "$HOME/sslcerts/privkey.pem" "$2/"
else
  echo "ERROR: Certificates not found in $HOME/sslcerts/" >&2
  exit 1
fi
